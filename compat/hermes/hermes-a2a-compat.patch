+def extract_sender_context(params: dict) -> Optional[dict]:
+    """Bounded descriptive labels only; never grants peer identity or policy."""
+    message = params.get("message", {})
+    metadata = message.get("metadata", {}) if isinstance(message, dict) else {}
+    value = metadata.get("sender_context") if isinstance(metadata, dict) else None
+    if value is None:
+        return None
+    if not isinstance(value, dict) or set(value) != {"harness", "model", "connection"}:
+        raise ValueError("invalid sender context")
+    if value["connection"] != "a2a":
+        raise ValueError("invalid sender connection")
+    for key, limit in (("harness", 64), ("model", 256)):
+        label = value[key]
+        if key == "model" and label is None:
+            continue
+        if not isinstance(label, str) or not label.strip() or len(label) > limit or any(ord(c) < 32 for c in label):
+            raise ValueError("invalid sender label")
+    return dict(value)
