+def gateway_capabilities(selected: bool) -> dict:
+    return {"diagnostics_extension": GATEWAY_DIAGNOSTICS, "patch_version": "0.8.0",
+            "policy": "sliding_window" if selected else "legacy_turn_limit",
+            "context_limit": 5 if selected else max_pingpong_turns(),
+            **({"window_seconds": 60} if selected else {})}
+
+
+class GatewayContextLimiter:
+    """Five accepted submissions per 60s, by authenticated peer/agent/context.
+
+    Process-local like the existing global limiter. Rejections and reads do not
+    extend the window. This is rate protection, not causal loop detection.
+    """
+    def __init__(self, clock=time.monotonic, wall_clock=time.time):
+        self._clock, self._wall_clock = clock, wall_clock
+        self._buckets = {}
+        self._lock = threading.Lock()
+
+    def admit(self, peer: str, scope: tuple[str, str], context: str) -> Optional[dict]:
+        with self._lock:
+            now = self._clock()
+            for key in list(self._buckets):
+                bucket = self._buckets[key]
+                while bucket and bucket[0] <= now - 60:
+                    bucket.popleft()
+                if not bucket:
+                    del self._buckets[key]
+            key = (peer, *scope, context)
+            bucket = self._buckets.setdefault(key, deque())
+            if len(bucket) >= 5:
+                delay = max(1, math.ceil(bucket[0] + 60 - now))
+                retry_at = datetime.fromtimestamp(self._wall_clock() + delay, timezone.utc).isoformat()
+                return {"reason": "context_rate_limited", "peer_state": "rejected",
+                        "execution_started": False, "retry_after_seconds": delay,
+                        "retry_at": retry_at, "recommended_action": "wait_then_submit_new"}
+            bucket.append(now)
+        return None
+
 
